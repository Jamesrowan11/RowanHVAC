# Optional deploy configuration, sourced by scripts/cpanel-deploy.sh.
# Copy to "deploy.config" (git-ignored) on the server and edit.
#
# If PUBLIC_DEPLOY_PATH is set, each portal deploy will ALSO rebuild the static
# marketing site and copy it into that subdomain's document root — a single
# "Deploy HEAD Commit" then updates both sites.

# Document root of the rowanhvac.rowancopy.com subdomain on the server:
# PUBLIC_DEPLOY_PATH="/home/youruser/rowanhvac.rowancopy.com"

# URLs baked into the static site at build time:
# NEXT_PUBLIC_PORTAL_URL="https://rowanhvacportal.rowancopy.com"
# NEXT_PUBLIC_SITE_URL="https://rowanhvac.rowancopy.com"
