{
  "name": "rowanhvac",
  "version": "1.0.0",
  "private": true,
  "description": "Rowan Heating & Air Conditioning — public website and client/employee/admin portal",
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && next build",
    "deploy": "prisma generate && prisma migrate deploy && next build",
    "update": "git pull && npm install && npm run deploy",
    "start": "next start",
    "lint": "next lint",
    "postinstall": "prisma generate",
    "db:migrate": "prisma migrate deploy",
    "db:seed": "tsx prisma/seed.ts"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@prisma/client": "^6.8.0",
    "@types/node": "^22.15.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "autoprefixer": "^10.4.20",
    "bcryptjs": "^3.0.2",
    "next": "^15.3.2",
    "next-auth": "^5.0.0-beta.28",
    "postcss": "^8.5.0",
    "prisma": "^6.8.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "resend": "^4.5.0",
    "tailwindcss": "^3.4.17",
    "tsx": "^4.19.0",
    "typescript": "^5.8.0",
    "web-push": "^3.6.7",
    "@types/web-push": "^3.6.4",
    "zod": "^3.24.0"
  }
}
