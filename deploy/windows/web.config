<?xml version="1.0" encoding="UTF-8"?>
<!--
  IIS reverse proxy for the Rowan HVAC Node app on Windows.
  Put this web.config in the IIS site's physical path (e.g. C:\inetpub\rowanhvac).
  IIS receives 80/443 (and the SSL cert) and forwards everything to the Node
  app running on 127.0.0.1:3000 (started with PM2).

  Requires two free IIS modules installed first:
    - URL Rewrite:  https://www.iis.net/downloads/microsoft/url-rewrite
    - Application Request Routing (ARR): https://www.iis.net/downloads/microsoft/application-request-routing
  After installing ARR, enable the proxy: IIS Manager → server node → "Application
  Request Routing Cache" → Server Proxy Settings → check "Enable proxy".
-->
<configuration>
  <system.webServer>
    <webSocket enabled="true" />
    <rewrite>
      <rules>
        <rule name="ReverseProxyToNode" stopProcessing="true">
          <match url="(.*)" />
          <action type="Rewrite" url="http://127.0.0.1:3000/{R:1}" />
        </rule>
      </rules>
    </rewrite>
    <!-- Allow large document uploads through the proxy (~12 MB). -->
    <security>
      <requestFiltering>
        <requestLimits maxAllowedContentLength="12582912" />
      </requestFiltering>
    </security>
    <httpErrors existingResponse="PassThrough" />
  </system.webServer>
</configuration>
