# Build-time configuration for the public marketing site (static export).
# These are inlined into the HTML/JS at build time. Copy to .env.local before
# building, or pass them on the command line.

# URL of the portal (the Node.js app on the other subdomain). The "Portal Login"
# link and the quote form's POST target are built from this.
NEXT_PUBLIC_PORTAL_URL="https://rowanhvacportal.rowancopy.com"

# This site's own public URL (used for canonical/OpenGraph metadata).
NEXT_PUBLIC_SITE_URL="https://rowanhvac.rowancopy.com"
