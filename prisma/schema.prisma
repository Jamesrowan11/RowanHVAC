generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

enum Role {
  CLIENT
  EMPLOYEE
  ADMIN
}

enum JobStatus {
  SCHEDULED
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

enum JobKind {
  SERVICE
  PICKUP
}

enum RequestStatus {
  NEW
  CONVERTED
  CLOSED
}

enum PaymentStatus {
  SENT
  PAID
}

enum EmailStatus {
  SENT
  LOGGED
  FAILED
}

enum SmsStatus {
  SENT
  LOGGED
  FAILED
}

model User {
  id            String    @id @default(cuid())
  name          String
  email         String    @unique
  phone         String?
  address       String?   @db.VarChar(300)
  passwordHash  String
  role          Role      @default(CLIENT)
  active        Boolean   @default(true)
  // Maintenance / service agreement (clients)
  policyActive  Boolean   @default(false)
  policyRenewal DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  jobsAsTechnician   Job[]               @relation("JobTechnician")
  jobsAsClient       Job[]               @relation("JobClient")
  jobNotes           JobNote[]
  quoteRequests      QuoteRequest[]
  announcements      Announcement[]
  paymentLinks       PaymentLink[]       @relation("PaymentClient")
  paymentLinksSent   PaymentLink[]       @relation("PaymentCreator")
  documents          Document[]          @relation("DocumentClient")
  documentsUploaded  Document[]          @relation("DocumentUploader")
  emailsSent         EmailLog[]
  threadMemberships  ThreadParticipant[]
  messages           Message[]
  customerNotes      CustomerNote[]      @relation("CustomerNoteSubject")
  customerNotesMade  CustomerNote[]      @relation("CustomerNoteAuthor")
  employeeNotes      EmployeeNote[]      @relation("EmployeeNoteSubject")
  employeeNotesMade  EmployeeNote[]      @relation("EmployeeNoteAuthor")
}

model QuoteRequest {
  id        String        @id @default(cuid())
  name      String
  phone     String
  email     String
  service   String
  message   String        @db.Text
  source    String        @default("PUBLIC") // PUBLIC | PORTAL | MAINTENANCE
  status    RequestStatus @default(NEW)
  clientId  String?
  client    User?         @relation(fields: [clientId], references: [id], onDelete: SetNull)
  createdAt DateTime      @default(now())
}

model Job {
  id           String    @id @default(cuid())
  customerName String
  address      String    @db.VarChar(300)
  service      String    @db.VarChar(200)
  kind         JobKind   @default(SERVICE)
  scheduledAt  DateTime
  endAt        DateTime?
  status       JobStatus @default(SCHEDULED)
  summary      String?   @db.Text
  cancelReason String?   @db.Text
  cancelledAt  DateTime?
  completedAt  DateTime?

  technicianId String
  technician   User      @relation("JobTechnician", fields: [technicianId], references: [id])
  clientId     String?
  client       User?     @relation("JobClient", fields: [clientId], references: [id], onDelete: SetNull)

  notes     JobNote[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([technicianId, status])
  @@index([clientId])
}

model JobNote {
  id          String       @id @default(cuid())
  jobId       String
  job         Job          @relation(fields: [jobId], references: [id], onDelete: Cascade)
  authorId    String
  author      User         @relation(fields: [authorId], references: [id])
  body        String       @db.Text
  attachments Attachment[]
  createdAt   DateTime     @default(now())
}

model Announcement {
  id        String   @id @default(cuid())
  title     String
  body      String   @db.Text
  authorId  String
  author    User     @relation(fields: [authorId], references: [id])
  createdAt DateTime @default(now())
}

model PaymentLink {
  id          String        @id @default(cuid())
  clientId    String
  client      User          @relation("PaymentClient", fields: [clientId], references: [id], onDelete: Cascade)
  url         String        @db.VarChar(2000)
  label       String?
  status      PaymentStatus @default(SENT)
  paidAt      DateTime?
  createdById String
  createdBy   User          @relation("PaymentCreator", fields: [createdById], references: [id])
  createdAt   DateTime      @default(now())
}

model Document {
  id           String   @id @default(cuid())
  clientId     String
  client       User     @relation("DocumentClient", fields: [clientId], references: [id], onDelete: Cascade)
  fileName     String
  storagePath  String
  mimeType     String
  size         Int
  uploadedById String
  uploadedBy   User     @relation("DocumentUploader", fields: [uploadedById], references: [id])
  createdAt    DateTime @default(now())
}

model EmailLog {
  id           String      @id @default(cuid())
  senderUserId String?
  sender       User?       @relation(fields: [senderUserId], references: [id], onDelete: SetNull)
  toAddresses  String      @db.Text
  subject      String      @db.VarChar(300)
  body         String      @db.Text
  status       EmailStatus
  error        String?     @db.Text
  createdAt    DateTime    @default(now())

  @@index([senderUserId])
}

model Thread {
  id           String              @id @default(cuid())
  subject      String              @db.VarChar(200)
  createdAt    DateTime            @default(now())
  updatedAt    DateTime            @updatedAt
  participants ThreadParticipant[]
  messages     Message[]
}

model ThreadParticipant {
  threadId   String
  thread     Thread    @relation(fields: [threadId], references: [id], onDelete: Cascade)
  userId     String
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  lastReadAt DateTime?

  @@id([threadId, userId])
}

model Message {
  id          String       @id @default(cuid())
  threadId    String
  thread      Thread       @relation(fields: [threadId], references: [id], onDelete: Cascade)
  authorId    String
  author      User         @relation(fields: [authorId], references: [id])
  body        String       @db.Text
  viaEmail    Boolean      @default(false)
  attachments Attachment[]
  createdAt   DateTime     @default(now())

  @@index([threadId, createdAt])
}

model Attachment {
  id           String   @id @default(cuid())
  jobNoteId    String?
  jobNote      JobNote? @relation(fields: [jobNoteId], references: [id], onDelete: Cascade)
  messageId    String?
  message      Message? @relation(fields: [messageId], references: [id], onDelete: Cascade)
  fileName     String
  storagePath  String
  mimeType     String
  size         Int
  uploadedById String
  createdAt    DateTime @default(now())

  @@index([jobNoteId])
  @@index([messageId])
}

model SmsLog {
  id           String    @id @default(cuid())
  senderUserId String?
  toNumbers    String    @db.Text
  body         String    @db.Text
  status       SmsStatus
  error        String?   @db.Text
  createdAt    DateTime  @default(now())

  @@index([senderUserId])
}

model UnmatchedInbound {
  id          String   @id @default(cuid())
  fromAddress String
  subject     String   @db.VarChar(300)
  body        String   @db.Text
  resolved    Boolean  @default(false)
  createdAt   DateTime @default(now())
}

model CustomerNote {
  id        String   @id @default(cuid())
  clientId  String
  client    User     @relation("CustomerNoteSubject", fields: [clientId], references: [id], onDelete: Cascade)
  authorId  String
  author    User     @relation("CustomerNoteAuthor", fields: [authorId], references: [id])
  body      String   @db.Text
  createdAt DateTime @default(now())
}

model EmployeeNote {
  id         String   @id @default(cuid())
  employeeId String
  employee   User     @relation("EmployeeNoteSubject", fields: [employeeId], references: [id], onDelete: Cascade)
  authorId   String
  author     User     @relation("EmployeeNoteAuthor", fields: [authorId], references: [id])
  body       String   @db.Text
  createdAt  DateTime @default(now())
}

model TeamMember {
  id        String   @id @default(cuid())
  name      String
  title     String?
  photoPath String?
  mimeType  String?
  sortOrder Int      @default(0)
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
}

model Setting {
  key   String @id
  value String @db.Text
}
