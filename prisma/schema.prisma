generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

enum Role {
  CLIENT
  EMPLOYEE
  ADMIN
}

enum JobStatus {
  SCHEDULED
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

enum JobKind {
  SERVICE
  PICKUP
}

enum RequestStatus {
  NEW
  CONVERTED
  CLOSED
}

enum PaymentStatus {
  SENT
  PAID
}

enum EmailStatus {
  SENT
  LOGGED
  FAILED
}

enum SmsStatus {
  SENT
  LOGGED
  FAILED
}

enum TicketStatus {
  DRAFT
  SUBMITTED
}

enum BillingStatus {
  BILLABLE
  NO_CHARGE
  NEEDS_REVIEW
}

enum PriceUnit {
  EACH
  PER_POUND
}

model User {
  id            String    @id @default(cuid())
  name          String
  email         String    @unique
  phone         String?
  address       String?   @db.VarChar(300)
  // Short human-friendly account number, assigned to CLIENTs — used on
  // service tickets and in the QuickBooks export.
  customerNumber Int?     @unique
  // Where a CLIENT wants invoices/payment links emailed, when different
  // from their login email (e.g. a spouse or bookkeeper).
  billingEmail  String?
  passwordHash  String
  role          Role      @default(CLIENT)
  active        Boolean   @default(true)
  // Maintenance / service agreement (clients)
  policyActive  Boolean   @default(false)
  policyRenewal DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  jobsAsTechnician   JobAssignment[]
  jobsAsClient       Job[]               @relation("JobClient")
  jobNotes           JobNote[]
  quoteRequests      QuoteRequest[]
  announcements      Announcement[]
  paymentLinks       PaymentLink[]       @relation("PaymentClient")
  paymentLinksSent   PaymentLink[]       @relation("PaymentCreator")
  documents          Document[]          @relation("DocumentClient")
  documentsUploaded  Document[]          @relation("DocumentUploader")
  emailsSent         EmailLog[]
  threadMemberships  ThreadParticipant[]
  messages           Message[]
  customerNotes      CustomerNote[]      @relation("CustomerNoteSubject")
  customerNotesMade  CustomerNote[]      @relation("CustomerNoteAuthor")
  employeeNotes      EmployeeNote[]      @relation("EmployeeNoteSubject")
  employeeNotesMade  EmployeeNote[]      @relation("EmployeeNoteAuthor")
  pushSubscriptions  PushSubscription[]
  mailboxAccess      MailboxAccess[]
  ticketsAsTech      ServiceTicket[]     @relation("TicketTech")
  ticketsAsClient    ServiceTicket[]     @relation("TicketClient")
  proposals          Proposal[]          @relation("ProposalClient")
  proposalsCreated   Proposal[]          @relation("ProposalCreator")
  extraAddresses     ClientAddress[]
}

/** Additional service addresses for a client (contractors and landlords
 * often have many properties). The client's primary address stays on the
 * User record; these are the extras. */
model ClientAddress {
  id        String   @id @default(cuid())
  clientId  String
  client    User     @relation(fields: [clientId], references: [id], onDelete: Cascade)
  label     String? // e.g. "Rental — Laurel", "Job site: 5th St"
  address   String   @db.VarChar(400)
  createdAt DateTime @default(now())

  @@index([clientId])
}

model QuoteRequest {
  id        String        @id @default(cuid())
  name      String
  phone     String
  email     String
  service   String
  message   String        @db.Text
  source    String        @default("PUBLIC") // PUBLIC | PORTAL | MAINTENANCE
  status    RequestStatus @default(NEW)
  clientId  String?
  client    User?         @relation(fields: [clientId], references: [id], onDelete: SetNull)
  createdAt DateTime      @default(now())
}

model Job {
  id           String    @id @default(cuid())
  customerName String
  address      String    @db.VarChar(300)
  service      String    @db.VarChar(200)
  kind         JobKind   @default(SERVICE)
  scheduledAt  DateTime
  // Appointments are booked as AM or PM arrival windows, not exact times.
  // scheduledAt anchors the day (8:00 for AM, 13:00 for PM) so sorting and
  // the calendar still work; window is what customers and staff see.
  window       String? // AM | PM (null on legacy exact-time jobs)
  endAt        DateTime?
  status       JobStatus @default(SCHEDULED)
  summary      String?   @db.Text
  cancelReason String?   @db.Text
  cancelledAt  DateTime?
  completedAt  DateTime?

  // "You're next — okay now, or wait?" customer confirmation
  confirmToken       String?   @unique
  confirmStatus      String?   // ASKED | READY | WAIT
  confirmAskedAt     DateTime?
  confirmRespondedAt DateTime?

  // Terms acceptance: when a job/pickup is scheduled for a portal client,
  // they're sent the hourly pricing terms + the current service agreement
  // to accept (checkbox + typed signature) by one day before the visit.
  // termsSnapshot keeps the exact agreement text they were shown, so later
  // edits to the agreement never change what was signed.
  acceptToken     String?   @unique
  termsSentAt     DateTime?
  termsAcceptedAt DateTime?
  termsSignature  String?
  termsSnapshot   String?   @db.Text
  // How the customer said they'll pay at time of service ("Check" / "Credit
  // card") — required on the acceptance form, per the scheduling letter.
  termsPaymentMethod String? @db.VarChar(40)

  // Assignment is optional at scheduling time, and not limited to one person —
  // many jobs get one or more technicians assigned the day of, either by an
  // admin or by techs claiming it themselves. See JobAssignment.
  assignments JobAssignment[]
  clientId    String?
  client      User?           @relation("JobClient", fields: [clientId], references: [id], onDelete: SetNull)

  notes     JobNote[]
  tickets   ServiceTicket[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([clientId])
}

/** Join table: assigns one technician (employee or admin) to one job. A job
 * can have any number of assigned technicians, and a technician can be
 * assigned to any number of jobs. */
model JobAssignment {
  id        String   @id @default(cuid())
  jobId     String
  job       Job      @relation(fields: [jobId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([jobId, userId])
  @@index([userId])
}

model JobNote {
  id          String       @id @default(cuid())
  jobId       String
  job         Job          @relation(fields: [jobId], references: [id], onDelete: Cascade)
  authorId    String
  author      User         @relation(fields: [authorId], references: [id])
  body        String       @db.Text
  attachments Attachment[]
  createdAt   DateTime     @default(now())
}

model Announcement {
  id        String   @id @default(cuid())
  title     String
  body      String   @db.Text
  authorId  String
  author    User     @relation(fields: [authorId], references: [id])
  createdAt DateTime @default(now())
}

model PaymentLink {
  id          String        @id @default(cuid())
  clientId    String
  client      User          @relation("PaymentClient", fields: [clientId], references: [id], onDelete: Cascade)
  url         String        @db.VarChar(2000)
  label       String?
  status      PaymentStatus @default(SENT)
  paidAt      DateTime?
  createdById String
  createdBy   User          @relation("PaymentCreator", fields: [createdById], references: [id])
  createdAt   DateTime      @default(now())
}

model Document {
  id           String   @id @default(cuid())
  clientId     String
  client       User     @relation("DocumentClient", fields: [clientId], references: [id], onDelete: Cascade)
  fileName     String
  storagePath  String
  mimeType     String
  size         Int
  uploadedById String
  uploadedBy   User     @relation("DocumentUploader", fields: [uploadedById], references: [id])
  createdAt    DateTime @default(now())
}

model EmailLog {
  id           String      @id @default(cuid())
  senderUserId String?
  sender       User?       @relation(fields: [senderUserId], references: [id], onDelete: SetNull)
  toAddresses  String      @db.Text
  subject      String      @db.VarChar(300)
  body         String      @db.Text
  status       EmailStatus
  error        String?     @db.Text
  createdAt    DateTime    @default(now())

  @@index([senderUserId])
}

model Thread {
  id           String              @id @default(cuid())
  subject      String              @db.VarChar(200)
  createdAt    DateTime            @default(now())
  updatedAt    DateTime            @updatedAt
  participants ThreadParticipant[]
  messages     Message[]
}

model ThreadParticipant {
  threadId   String
  thread     Thread    @relation(fields: [threadId], references: [id], onDelete: Cascade)
  userId     String
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  lastReadAt DateTime?

  @@id([threadId, userId])
}

model Message {
  id          String       @id @default(cuid())
  threadId    String
  thread      Thread       @relation(fields: [threadId], references: [id], onDelete: Cascade)
  authorId    String
  author      User         @relation(fields: [authorId], references: [id])
  body        String       @db.Text
  viaEmail    Boolean      @default(false)
  attachments Attachment[]
  createdAt   DateTime     @default(now())

  @@index([threadId, createdAt])
}

model Attachment {
  id              String         @id @default(cuid())
  jobNoteId       String?
  jobNote         JobNote?       @relation(fields: [jobNoteId], references: [id], onDelete: Cascade)
  messageId       String?
  message         Message?       @relation(fields: [messageId], references: [id], onDelete: Cascade)
  serviceTicketId String?
  serviceTicket   ServiceTicket? @relation(fields: [serviceTicketId], references: [id], onDelete: Cascade)
  fileName        String
  storagePath     String
  mimeType        String
  size            Int
  uploadedById    String
  createdAt       DateTime       @default(now())

  @@index([jobNoteId])
  @@index([messageId])
  @@index([serviceTicketId])
}

/** A field service ticket, filled out section-by-section (wizard) by a tech.
 * Pricing totals and line items are SNAPSHOTS frozen at submit time — later
 * price-book edits never change past tickets. */
model ServiceTicket {
  id           String        @id @default(cuid())
  ticketNumber Int           @unique @default(autoincrement())
  status       TicketStatus  @default(DRAFT)

  techId String
  tech   User   @relation("TicketTech", fields: [techId], references: [id])

  // The schedule event (calendar job) this ticket documents. Starting a
  // ticket from a job prefills customer/address/date from it.
  jobId String?
  job   Job?    @relation(fields: [jobId], references: [id], onDelete: SetNull)

  // Customer & job
  clientId       String?
  client         User?    @relation("TicketClient", fields: [clientId], references: [id], onDelete: SetNull)
  customerName   String   @default("")
  serviceAddress String   @default("") @db.VarChar(300)
  serviceDate    DateTime @default(now())

  // Time & labor (drives pricing)
  timeIn           DateTime?
  timeOut          DateTime?
  zone             String? // matches LaborRate.zone
  techCount        Int       @default(1)
  ladderUsed       Boolean   @default(false)
  maintenanceVisit Boolean   @default(false)

  // Equipment
  systemType   String?
  brand        String?
  modelNumber  String?
  serialNumber String?
  ageYears     Int?

  // Readings / measurements (optional; strings keep formats like "35/5" easy)
  capRated        String?
  capTested       String?
  suctionBefore   String?
  suctionAfter    String?
  liquidBefore    String?
  liquidAfter     String?
  superheat       String?
  subcooling      String?
  compressorAmps  String?
  fanAmps         String?
  supplyAirTemp   String?
  refrigerantType String?
  refrigerantLbs  Decimal? @db.Decimal(8, 2)
  readingsNotes   String?  @db.Text

  workPerformed String? @db.Text

  billingStatus      BillingStatus @default(BILLABLE)
  // Customer settled up on the spot (cash/check/card with the tech).
  paidOnSite         Boolean       @default(false)
  paymentNote        String? // e.g. "check #1042", "cash"
  // Set at submit when the duration exceeds the labor table (over 6 hrs) or
  // a matching rate row is missing — admin prices it by hand.
  needsManualPricing Boolean       @default(false)
  laborTotal         Decimal?      @db.Decimal(10, 2)
  partsTotal         Decimal?      @db.Decimal(10, 2)
  total              Decimal?      @db.Decimal(10, 2)

  submittedAt DateTime?
  exportedAt  DateTime?

  lineItems TicketLineItem[]
  photos    Attachment[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([techId, status])
  @@index([serviceDate])
  @@index([status, billingStatus])
  @@index([jobId])
}

/** One line on a ticket's bill. PART lines are created as the tech picks
 * parts; LABOR and ADDON lines are computed and frozen at submit. */
model TicketLineItem {
  id       String        @id @default(cuid())
  ticketId String
  ticket   ServiceTicket @relation(fields: [ticketId], references: [id], onDelete: Cascade)

  kind      String // LABOR | ADDON | PART
  label     String
  qty       Decimal? @db.Decimal(8, 2)
  unitPrice Decimal? @db.Decimal(10, 2)
  amount    Decimal  @db.Decimal(10, 2)

  priceItemId String?
  priceItem   PriceBookItem? @relation(fields: [priceItemId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())

  @@index([ticketId])
}

/** One row of the labor lookup table: zone + rounded duration → price.
 * twoTechPrice overrides the global 2-tech multiplier for that row when set. */
model LaborRate {
  id           String  @id @default(cuid())
  zone         String
  minutes      Int
  price        Decimal  @db.Decimal(10, 2)
  twoTechPrice Decimal? @db.Decimal(10, 2)

  @@unique([zone, minutes])
}

/** Parts & materials price book. Refrigerant is priced PER_POUND. */
model PriceBookItem {
  id         String    @id @default(cuid())
  name       String
  partNumber String?
  unit       PriceUnit @default(EACH)
  unitPrice  Decimal   @db.Decimal(10, 2)
  active     Boolean   @default(true)
  createdAt  DateTime  @default(now())

  lineItems TicketLineItem[]
}

model SmsLog {
  id           String    @id @default(cuid())
  senderUserId String?
  toNumbers    String    @db.Text
  body         String    @db.Text
  status       SmsStatus
  error        String?   @db.Text
  createdAt    DateTime  @default(now())

  @@index([senderUserId])
}

model UnmatchedInbound {
  id          String   @id @default(cuid())
  fromAddress String
  subject     String   @db.VarChar(300)
  body        String   @db.Text
  resolved    Boolean  @default(false)
  createdAt   DateTime @default(now())
}

model CustomerNote {
  id        String   @id @default(cuid())
  clientId  String
  client    User     @relation("CustomerNoteSubject", fields: [clientId], references: [id], onDelete: Cascade)
  authorId  String
  author    User     @relation("CustomerNoteAuthor", fields: [authorId], references: [id])
  body      String   @db.Text
  createdAt DateTime @default(now())
}

model EmployeeNote {
  id         String   @id @default(cuid())
  employeeId String
  employee   User     @relation("EmployeeNoteSubject", fields: [employeeId], references: [id], onDelete: Cascade)
  authorId   String
  author     User     @relation("EmployeeNoteAuthor", fields: [authorId], references: [id])
  body       String   @db.Text
  createdAt  DateTime @default(now())
}

model TeamMember {
  id        String   @id @default(cuid())
  name      String
  title     String?
  photoPath String?
  mimeType  String?
  sortOrder Int      @default(0)
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
}

model Setting {
  key   String @id
  value String @db.Text
}

/** A real @rowanhvac.com mailbox's credentials, stored once regardless of how
 * many portal accounts are granted access to it (see MailboxAccess). */
model Mailbox {
  id                String          @id @default(cuid())
  address           String          @unique @db.VarChar(255)
  encryptedPassword String          @db.Text
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt
  access            MailboxAccess[]
}

/** Join table: grants one portal account read/send access to one Mailbox.
 * Many-to-many — a mailbox can be shared by several staff, and a staff
 * member can have access to several mailboxes. */
model MailboxAccess {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  mailboxId String
  mailbox   Mailbox  @relation(fields: [mailboxId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([userId, mailboxId])
  @@index([mailboxId])
}

/** An installation proposal document (letterhead, scope of work, price,
 * payment terms, signature block) — edited in the portal with a live
 * preview, assignable to a client, and printable/saved as PDF. */
model Proposal {
  id           String   @id @default(cuid())
  title        String   @default("Proposal")
  date         DateTime @default(now())
  clientId     String?
  client       User?    @relation("ProposalClient", fields: [clientId], references: [id], onDelete: SetNull)
  customerName String   @default("")
  phone        String?
  email        String?
  address      String   @default("") @db.VarChar(400)
  body         String   @db.Text // "We hereby propose to furnish and install…"
  price        String? // free-form, e.g. "$14,500.00"
  paymentTerms String?  @db.Text
  note         String?  @db.Text
  createdById  String
  createdBy    User     @relation("ProposalCreator", fields: [createdById], references: [id])
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([clientId])
}

model AnalyticsEvent {
  id        String   @id @default(cuid())
  type      String   @db.VarChar(40) // PAGE_VIEW | CALL_CLICK | QUOTE_CLICK
  createdAt DateTime @default(now())

  @@index([type, createdAt])
}

model PushSubscription {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  endpoint  String   @unique @db.VarChar(500)
  p256dh    String   @db.VarChar(255)
  auth      String   @db.VarChar(255)
  createdAt DateTime @default(now())

  @@index([userId])
}

model ServiceArea {
  id        String  @id @default(cuid())
  region    String
  town      String
  zips      String  @db.Text // space/comma-separated ZIP codes
  sortOrder Int     @default(0)
  active    Boolean @default(true)

  @@index([active])
}
