# --- Database ---------------------------------------------------------------
# MySQL / MariaDB connection string. On Plesk, create the database and user
# under "Databases", then plug them in here (URL-encode special characters
# in the password).
DATABASE_URL="mysql://USER:PASSWORD@localhost:3306/DATABASE"

# --- Auth -------------------------------------------------------------------
# Generate with:  openssl rand -base64 32
AUTH_SECRET="replace-with-a-long-random-string"
# Public URL of the app (used by Auth.js and in links inside emails)
NEXTAUTH_URL="http://localhost:3000"
APP_URL="http://localhost:3000"

# --- Email (optional — app runs fully without these) -------------------------
# When RESEND_API_KEY is unset, every outgoing email is logged to the console
# instead of being sent, and still recorded in the Sent Email history.
RESEND_API_KEY=""
EMAIL_FROM="Rowan Heating & Air <info@rowanhvac.com>"

# --- SMS via Nextiva (optional — app runs fully without these) ----------------
# Texts go out from the company's Nextiva business number. Nextiva's SMS API is
# account-gated, so get the send endpoint + API key from your Nextiva developer
# account / account rep and fill these in. If unset, every SMS is logged to the
# console (and recorded in SMS history) instead of being sent.
NEXTIVA_API_URL=""
NEXTIVA_API_KEY=""
NEXTIVA_FROM="+14105310008"

# --- Inbound email webhook ----------------------------------------------------
# Shared secret for POST /api/email/inbound (SendGrid/Mailgun/Postmark style).
# If unset, the endpoint is open (local development only — set this in prod!).
INBOUND_WEBHOOK_SECRET=""
