# =====================================================================
# Rowan Heating & Air Conditioning: one app on one domain
# (rowanheatingandair.com): the public website, customer + staff portal, and
# the van app's sync API.
#
# Behind the DigitalOcean Load Balancer, put the SAME .env on every droplet
# (see deploy/digitalocean/README.md): the secrets must match.
# =====================================================================

# ---- Database (DigitalOcean Managed MySQL) ----
# Private-network host, port 25060, SSL with the cluster's CA certificate.
DATABASE_URL="mysql://rowanhvac:PASSWORD@private-db-host:25060/rowanhvac?sslaccept=strict&sslcert=/etc/rowanhvac/ca-certificate.crt"

# ---- Auth (NextAuth / Auth.js v5) ----
# Generate each with: openssl rand -base64 32
AUTH_SECRET="change-me-to-a-long-random-string"
# Encrypts form submissions (server actions); the same value on every
# droplet lets any droplet handle a form another one served.
NEXT_SERVER_ACTIONS_ENCRYPTION_KEY="change-me-openssl-rand-base64-32"
# The site's own address (used for sign-in, password-reset links, emails).
AUTH_URL="https://rowanheatingandair.com"

# Leave unset: "/" is the public home page. Only for a portal-only install
# (no public website), PORTAL_ONLY="1" sends "/" straight to the login page.
# PORTAL_ONLY="1"

# ---- File storage: DigitalOcean Spaces ----
# Customer documents and equipment manuals. Required behind the load balancer
# (all droplets must see the same files). Without SPACES_BUCKET, files go to
# UPLOAD_DIR on the server's own disk (fine for one server / development).
SPACES_BUCKET="rowanhvac-files"
SPACES_REGION="nyc3"
SPACES_KEY=""
SPACES_SECRET=""
# SPACES_ENDPOINT="https://nyc3.digitaloceanspaces.com"   # default from the region
# SPACES_PREFIX="uploads/"
# UPLOAD_DIR="/var/www/rowanhvac-uploads"                  # local-disk mode only

# ---- Email: Zoho Mail (mailboxes @rowanheatingandair.com) ----
# Zoho Mail Lite or higher (the free plan has no IMAP/SMTP). Turn on IMAP
# access for each mailbox in Zoho Mail settings.
#
# The website's automatic emails (password resets, notifications, vehicle
# alerts) are sent from this company mailbox. With two-factor sign-in on it,
# use a Zoho app-specific password.
EMAIL_FROM="Rowan Heating & Air Conditioning <info@rowanheatingandair.com>"
EMAIL_SMTP_USER="info@rowanheatingandair.com"
EMAIL_SMTP_PASSWORD=""
# (Alternatively leave EMAIL_SMTP_* empty and set RESEND_API_KEY to send via
# Resend. With neither, emails are only logged to the server console.)
# RESEND_API_KEY=""

# Van app "Email" tab: techs send as themselves from their own Zoho mailbox
# (SMTP to send, IMAP to save a copy in their Sent folder). The defaults are
# Zoho's servers for organization accounts in the US data center.
# MAIL_SMTP_HOST="smtppro.zoho.com"          # EU data center: smtppro.zoho.eu
# MAIL_IMAP_HOST="imappro.zoho.com"          # EU data center: imappro.zoho.eu
# MAIL_SMTP_PORT="465"                       # 465 = TLS, 587 = STARTTLS
# MAIL_IMAP_PORT="993"
# MAIL_ALLOWED_DOMAIN="rowanheatingandair.com"
# MAIL_SENT_FOLDER=""                        # only if auto-detect picks the wrong folder
# Key for encrypting stored mailbox passwords (defaults to one derived from
# AUTH_SECRET; if you change it, techs must reconnect their email once).
# MAILBOX_SECRET="another-long-random-string"

# ---- Vehicles (OBD-II speed + trouble codes from the vans) ----
# Time zone for the admin Vehicles page (day boundaries, times in emails).
# APP_TIMEZONE="America/New_York"
# Email the admins when a van goes over this speed (max one email per van per
# hour). 0 turns speed alerts off. New trouble codes are always emailed.
# SPEED_ALERT_MPH="80"
# How long speed readings are kept.
# SPEED_RETENTION_DAYS="365"

# ---- Inbound email webhook ----
INBOUND_EMAIL_SECRET="change-me-inbound-secret"

# ---- Server ----
# PM2 (ecosystem.config.js) sets PORT/HOST; set these only to run
# `node server.js` by hand.
# PORT="3000"
