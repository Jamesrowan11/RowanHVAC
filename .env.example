# --- Database ---------------------------------------------------------------
# MySQL / MariaDB connection string. On Plesk, create the database and user
# under "Databases", then plug them in here (URL-encode special characters
# in the password).
DATABASE_URL="mysql://USER:PASSWORD@localhost:3306/DATABASE"

# --- Auth -------------------------------------------------------------------
# Generate with:  openssl rand -base64 32
AUTH_SECRET="replace-with-a-long-random-string"
# Public URL of the app (used by Auth.js and in links inside emails)
NEXTAUTH_URL="http://localhost:3000"
APP_URL="http://localhost:3000"

# --- Email (optional — app runs fully without these) -------------------------
# When RESEND_API_KEY is unset, every outgoing email is logged to the console
# instead of being sent, and still recorded in the Sent Email history.
RESEND_API_KEY=""
EMAIL_FROM="Rowan Heating & Air <info@rowanhvac.com>"

# --- SMS (optional — app runs fully without these) ----------------------------
# Choose the provider: "twilio" (default), "nextiva", or "ringcentral".
SMS_PROVIDER="ringcentral"

# Twilio (self-serve; works immediately):
TWILIO_ACCOUNT_SID=""
TWILIO_AUTH_TOKEN=""
TWILIO_FROM="+14105310008"

# Nextiva (only if API SMS is enabled on your Nextiva account — get the send
# endpoint + API key from Nextiva). Set SMS_PROVIDER="nextiva" to use these.
NEXTIVA_API_URL=""
NEXTIVA_API_KEY=""
NEXTIVA_FROM="+14105310008"

# RingCentral (Server-to-Server OAuth app in the RingCentral Developer Console
# — developers.ringcentral.com > your app > Auth Settings must have "JWT auth
# flow" enabled, and the app must be authorized on your RingCentral account).
# RC_JWT is the JWT credential the console gives you, not one you construct.
# RC_FROM_NUMBER must be an SMS-enabled number on your RingCentral account.
RC_SERVER="https://platform.ringcentral.com"
RC_CLIENT_ID=""
RC_CLIENT_SECRET=""
RC_JWT=""
RC_FROM_NUMBER=""

# --- Plesk mail management (optional) --------------------------------------
# Lets Admin -> Email Accounts create/delete @rowanhvac.com mailboxes and set
# forwarding, without logging into Plesk. IMPORTANT: generate the secret key
# scoped to the Plesk customer that owns rowanhvac.com (see README), and note
# that if that customer account also owns other domains on this server, the
# key itself is not limited to rowanhvac.com — only this app's code is (it
# never accepts a site id from anywhere but this env var). Get the numeric
# site id with: plesk bin site --info rowanhvac.com  (look for "Domain ID").
PLESK_API_HOST=""
PLESK_API_KEY=""
PLESK_MAIL_SITE_ID=""
PLESK_MAIL_DOMAIN="rowanhvac.com"
# Only set to "true" if the Plesk panel's own TLS cert doesn't validate for
# PLESK_API_HOST (e.g. calling by bare IP). Leave unset/false otherwise.
PLESK_API_INSECURE_TLS=""

# --- Linked mailboxes (optional) — read/send mail from a user's Profile --------
# Lets a staff member connect their real @rowanhvac.com mailbox and read/send
# it from "My Profile" in the portal (via IMAP/SMTP — Plesk mail has no OAuth,
# so this uses the mailbox's own password, encrypted at rest with the key
# below). MAILBOX_CREDENTIALS_KEY: generate with `openssl rand -hex 32`.
MAILBOX_CREDENTIALS_KEY=""
MAILBOX_HOST="mail.rowanhvac.com"
MAILBOX_IMAP_PORT="993"
MAILBOX_SMTP_PORT="465"
# Only set to "true" if the mail server's TLS cert doesn't validate.
MAILBOX_TLS_INSECURE=""

# --- Google tag (optional) -----------------------------------------------------
# Google Ads / Analytics tag id (e.g. AW-XXXXXXXXXXX or G-XXXXXXXXXX). When set,
# the gtag loads on every page and CTA clicks/form submits fire as events.
GTAG_ID=""

# --- Push notifications (optional — app runs fully without these) --------------
# Web push to the installed app / phones. Generate keys once with:
#   npx web-push generate-vapid-keys
# then paste them here. VAPID_SUBJECT is a mailto: contact.
VAPID_PUBLIC_KEY=""
VAPID_PRIVATE_KEY=""
VAPID_SUBJECT="mailto:info@rowanhvac.com"

# --- Android (Google Play TWA) Digital Asset Links ----------------------------
# Needed only when publishing the PWA to Google Play as a Trusted Web Activity.
# Get the package name you choose and the SHA-256 signing-cert fingerprint from
# PWABuilder / Play Console, then set these so /.well-known/assetlinks.json
# verifies the app. Leave blank otherwise.
ANDROID_PACKAGE_NAME=""
ANDROID_CERT_FINGERPRINT=""

# --- Inbound email webhook ----------------------------------------------------
# Shared secret for POST /api/email/inbound (SendGrid/Mailgun/Postmark style).
# If unset, the endpoint is open (local development only — set this in prod!).
INBOUND_WEBHOOK_SECRET=""
