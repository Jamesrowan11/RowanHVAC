# =====================================================================
# PORTAL app environment (rowanhvacportal.rowancopy.com — the Node.js app)
# Copy to .env in the portal's application root on the server.
# =====================================================================

# ---- Database (MySQL / MariaDB — what GoDaddy cPanel provides) ----
# Create the DB + user in cPanel → "MySQL Databases". cPanel prefixes names,
# e.g. cpuser_rowanhvac and cpuser_dbuser.
DATABASE_URL="mysql://cpuser_dbuser:PASSWORD@localhost:3306/cpuser_rowanhvac"

# ---- Auth (NextAuth / Auth.js v5) ----
# Generate a strong secret with: openssl rand -base64 32
AUTH_SECRET="change-me-to-a-long-random-string"
# The portal's own URL (helps Auth.js build callback URLs behind a subdomain).
AUTH_URL="https://rowanhvacportal.rowancopy.com"

# ---- Cross-subdomain CORS ----
# The public marketing site's origin. Its quote form POSTs to this app's
# /api/public/quote, so that origin must be allowed.
PUBLIC_SITE_ORIGIN="https://rowanhvac.rowancopy.com"

# ---- Email layer ----
# If RESEND_API_KEY is set, emails are sent via Resend. Otherwise emails are
# logged to the server console (the app runs fully without an email key).
RESEND_API_KEY=""
EMAIL_FROM="Rowan Heating & Air Conditioning <info@rowanhvac.com>"

# ---- File uploads ----
# Use a persistent path OUTSIDE the repo so redeploys never wipe customer files.
UPLOAD_DIR="/home/cpuser/rowanhvac-uploads"

# ---- Inbound email webhook ----
INBOUND_EMAIL_SECRET="change-me-inbound-secret"

# ---- Server (cPanel / Passenger) ----
# cPanel's Node.js app sets PORT automatically; only set this for local use of
# the custom server (node server.js).
# PORT="3000"

# =====================================================================
# PUBLIC site build-time vars (public-site/.env.local) — see public-site/.env.example
# NEXT_PUBLIC_PORTAL_URL="https://rowanhvacportal.rowancopy.com"
# NEXT_PUBLIC_SITE_URL="https://rowanhvac.rowancopy.com"
# =====================================================================
