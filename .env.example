# =====================================================================
# Rowan Heating & Air Conditioning: one app on one domain
# (rowanheatingandair.com): the public website, customer + staff portal, and
# the van app's sync API. Copy to .env in the app's root on the server.
# =====================================================================

# ---- Database (MySQL / MariaDB) ----
# Plesk: Databases → Add Database (e.g. database + user "rowanhvac").
DATABASE_URL="mysql://rowanhvac:PASSWORD@localhost:3306/rowanhvac"

# ---- Auth (NextAuth / Auth.js v5) ----
# Generate a strong secret with: openssl rand -base64 32
AUTH_SECRET="change-me-to-a-long-random-string"
# The site's own address (used for sign-in, password-reset links, emails).
AUTH_URL="https://rowanheatingandair.com"

# Leave unset: "/" is the public home page. Only for a portal-only install
# (no public website), PORTAL_ONLY="1" sends "/" straight to the login page.
# PORTAL_ONLY="1"

# ---- Email layer ----
# If RESEND_API_KEY is set, emails are sent via Resend. Otherwise emails are
# logged to the server console (the app runs fully without an email key).
RESEND_API_KEY=""
EMAIL_FROM="Rowan Heating & Air Conditioning <info@rowanheatingandair.com>"

# ---- Staff mailboxes (van app "Email" tab) ----
# Techs send email from their own company mailbox (the one they use in
# Roundcube at webmail.rowanheatingandair.com). The portal connects to the
# company mail server with each tech's own login: SMTP to send, IMAP to save a
# copy in their Sent folder. Defaults suit a standard Plesk mail setup.
# MAIL_HOST="mail.rowanheatingandair.com"   # use "localhost" if mail is on this same server
# MAIL_SMTP_PORT="587"                       # 587 = STARTTLS, 465 = TLS
# MAIL_IMAP_PORT="993"
# MAIL_ALLOWED_DOMAIN="rowanheatingandair.com"
# MAIL_SENT_FOLDER=""                        # only if auto-detect picks the wrong folder
# MAIL_TLS_ALLOW_SELF_SIGNED="1"             # only if mail still uses Plesk's self-signed cert
# Key for encrypting stored mailbox passwords (defaults to one derived from
# AUTH_SECRET; if you change it, techs must reconnect their email once).
# MAILBOX_SECRET="another-long-random-string"

# ---- Vehicles (OBD-II speed + trouble codes from the vans) ----
# Time zone for the admin Vehicles page (day boundaries, times in emails).
# APP_TIMEZONE="America/New_York"
# Email the admins when a van goes over this speed (max one email per van per
# hour). 0 turns speed alerts off. New trouble codes are always emailed.
# SPEED_ALERT_MPH="80"
# How long speed readings are kept.
# SPEED_RETENTION_DAYS="365"

# ---- File uploads ----
# Use a persistent path OUTSIDE the repo so redeploys never wipe customer files.
UPLOAD_DIR="/var/www/vhosts/rowanheatingandair.com/rowanhvac-uploads"

# ---- Inbound email webhook ----
INBOUND_EMAIL_SECRET="change-me-inbound-secret"

# ---- Server ----
# Plesk's Node.js (Passenger) sets PORT automatically; only set this for PM2
# or local use of the custom server (node server.js).
# PORT="3000"
