# ---- Database ----
# Any hosted Postgres connection string works (Vercel Postgres, Neon, Supabase, etc.)
DATABASE_URL="postgresql://rowan:rowan@localhost:5432/rowanhvac?schema=public"

# ---- Auth (NextAuth / Auth.js v5) ----
# Generate a strong secret with: openssl rand -base64 32
AUTH_SECRET="change-me-to-a-long-random-string"
# Optional explicit URL (Auth.js infers this on Vercel automatically)
# AUTH_URL="http://localhost:3000"

# ---- Email layer ----
# If RESEND_API_KEY is set, emails are sent via Resend. Otherwise emails are
# logged to the server console (the app runs fully without an email key).
RESEND_API_KEY=""
EMAIL_FROM="Rowan Heating & Air Conditioning <info@rowanhvac.com>"

# ---- File uploads ----
# Directory where uploaded documents are stored. Relative to the project root,
# or an absolute path. On cPanel use a persistent path outside the repo so a
# redeploy never wipes customer files, e.g. /home/youruser/rowanhvac-uploads
UPLOAD_DIR="uploads"

# ---- Server (cPanel / Passenger) ----
# cPanel's Node.js app sets PORT automatically; only set this for local use of
# the custom server (node server.js). Vercel/local dev do not need it.
# PORT="3000"

# ---- Inbound email webhook ----
# Shared secret required to POST to /api/email/inbound (set this in your provider).
INBOUND_EMAIL_SECRET="change-me-inbound-secret"
